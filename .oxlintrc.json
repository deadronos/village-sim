{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-await-in-loop": "off",
    "typescript/no-explicit-any": "warn"
  },
  "ignorePatterns": ["**/dist/**", "node_modules/**", "runs/**"]
}
