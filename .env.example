# Village Sim environment configuration
# Copy to `.env` (git-ignored) and adjust for your local setup.
# Precedence: CLI flags > shell env vars > .env.local > .env > village.config.json > defaults

# Decision provider: scripted | systemone | replay
DECISION_PROVIDER=scripted

# Local System One endpoint (e.g. Kev / Jev)
DECISION_ENDPOINT=http://127.0.0.1:8009/v1/systemone
DECISION_MODEL=kev-latest

# Request & batching tuning
DECISION_TIMEOUT_MS=120000
DECISION_BATCH=auto
DECISION_MAX_BATCH=3
DECISION_SAMPLE=weighted
DECISION_ESCALATE_ON=sampled
DECISION_MIN_CONF=0.34

# Optional bearer token for authenticated System One endpoints
DECISION_API_KEY=

# Live simulation backend HTTP port (used by `village serve` and Vite `/api` proxy)
PORT=4173
