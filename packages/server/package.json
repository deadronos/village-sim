{
  "name": "@village/server",
  "version": "0.3.1",
  "private": true,
  "bin": {
    "village": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch ./src/cli.ts serve",
    "village": "node ./src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@village/core": "workspace:*"
  }
}
